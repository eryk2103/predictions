{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as macros %}

{% block title %}Home{% endblock %}

{% block content %}
    <div class="container py-4">
    <h1 class="h3 mb-4">Current games</h1>

    {% if gamesGrouped is empty %}
        <p class="text-muted">No active phase games at the moment.</p>
    {% else %}
        {% for key, games in gamesGrouped %}
            <h5 class="mt-4 mb-2 text-muted fw-semibold">
                {{ key }}
            </h5>
            <div class="d-flex flex-column gap-2">
            {% for game in games %}
            <div class="card">
                <div class="card-body py-2 px-3"
                     style="display: grid; grid-template-columns: 1fr 5rem 1fr auto auto auto; align-items: center; gap: 0.75rem;">
                    <span class="fw-semibold text-end d-flex align-items-center justify-content-end gap-2">
                        {{ game.homeTeam ? game.homeTeam.shortName : '—' }}
                        {{ macros.team_logo(game.homeTeam, 24) }}
                    </span>
                    <span class="fw-bold text-center">
                        {% if game.homeScore is not null %}
                            {{ game.homeScore }} – {{ game.awayScore }}
                        {% else %}
                            vs
                        {% endif %}
                    </span>
                    <span class="fw-semibold d-flex align-items-center gap-2">
                        {{ macros.team_logo(game.awayTeam, 24) }}
                        {{ game.awayTeam ? game.awayTeam.shortName : '—' }}
                    </span>
                    <small class="text-nowrap">
                        {% set prediction = predictions[game.id] ?? null %}
                        {% if prediction %}
                            <span
                                class="text-primary fw-semibold">{{ prediction.homeScore }} – {{ prediction.awayScore }}</span>
                            {% if prediction.homePenalty is not null %}
                                <span
                                    class="text-muted">({{ prediction.homePenalty }} – {{ prediction.awayPenalty }})</span>
                            {% endif %}
                        {% endif %}
                    </small>
                    <small class="text-nowrap">
                        {% if game.status.value != 'scheduled' %}
                            <span
                                class="badge text-bg-secondary">{{ game.status.value|replace({'_': ' '})|title }}</span>
                        {% else %}
                            <span class="text-muted">{{ macros.local_time(game.datetime) }}</span>
                        {% endif %}
                    </small>
                    <a href="{{ path('game_show', {id: game.id}) }}"
                       class="btn btn-sm btn-outline-secondary text-nowrap">View</a>
                </div>
            </div>
        {% endfor %}
        </div>
        {% endfor %}
    {% endif %}
    </div>
{% endblock %}
