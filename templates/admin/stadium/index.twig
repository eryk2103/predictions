{% extends 'base.html.twig' %}

{% block title %}Stadiums{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Stadiums</h1>
        <a href="{{ path('admin_stadium_new') }}" class="btn btn-primary">New stadium</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Country</th>
                    <th>Capacity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for stadium in stadiums %}
                <tr>
                    <td>{{ stadium.id }}</td>
                    <td>{{ stadium.name }}</td>
                    <td>{{ stadium.city }}</td>
                    <td>{{ stadium.country ? stadium.country.name : '—' }}</td>
                    <td>{{ stadium.capacity ? stadium.capacity|number_format : '—' }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_stadium_show', {id: stadium.id}) }}" class="btn btn-sm btn-outline-secondary">View</a>
                        <a href="{{ path('admin_stadium_edit', {id: stadium.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No stadiums found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ include('_pagination.twig', {label: 'stadiums'}) }}
</div>
{% endblock %}
