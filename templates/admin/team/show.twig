{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as macros %}

{% block title %}{{ team.name }}{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">{{ team.name }}</h1>
        <div>
            <a href="{{ path('admin_team_edit', {id: team.id}) }}" class="btn btn-primary">Edit</a>
            <form method="post" action="{{ path('admin_team_delete', {id: team.id}) }}" class="d-inline"
                  onsubmit="return confirm('Delete {{ team.name }}?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Short name</dt>
                <dd class="col-sm-9">{{ team.shortName }}</dd>

                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9"><span class="badge text-bg-secondary">{{ team.code }}</span></dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">{{ team.city ?: '—' }}</dd>

                <dt class="col-sm-3">Country</dt>
                <dd class="col-sm-9">
                    {% if team.country %}
                        <a href="{{ path('admin_country_show', {id: team.country.id}) }}">{{ team.country.name }}</a>
                    {% else %}—{% endif %}
                </dd>

                <dt class="col-sm-3">Stadium</dt>
                <dd class="col-sm-9">
                    {% if team.stadium %}
                        <a href="{{ path('admin_stadium_show', {id: team.stadium.id}) }}">{{ team.stadium.name }}</a>
                    {% else %}—{% endif %}
                </dd>

                <dt class="col-sm-3">Logo</dt>
                <dd class="col-sm-9">
                    {% if team.logo %}{{ macros.team_logo(team, 64) }}{% else %}—{% endif %}
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">{{ team.createdAt|date('Y-m-d H:i') }}</dd>

                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">{{ team.updatedAt|date('Y-m-d H:i') }}</dd>
            </dl>
        </div>
    </div>

    <a href="{{ path('admin_team_index') }}" class="btn btn-link px-0 mt-3">← Back to list</a>
</div>
{% endblock %}
