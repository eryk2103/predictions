{% extends 'base.html.twig' %}

{% block title %}New country{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="h3 mb-4">New country</h1>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.flag, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.flag, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.flag) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="{{ path('admin_country_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
