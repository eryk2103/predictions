{% extends 'base.html.twig' %}

{% block title %}New competition{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="h3 mb-4">New competition</h1>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.shortName, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.shortName, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.shortName) }}
                </div>
                <div class="row">
                    <div class="col mb-3">
                        {{ form_label(form.startYear, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.startYear, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.startYear) }}
                    </div>
                    <div class="col mb-3">
                        {{ form_label(form.endYear, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.endYear, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.endYear) }}
                    </div>
                </div>
                <div class="mb-4">
                    {{ form_label(form.logo, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.logo, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.logo) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a href="{{ path('admin_competition_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
