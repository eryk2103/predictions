{% extends 'base.html.twig' %}

{% block title %}Standings{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Standings</h1>
            <a href="{{ path('standing_new') }}" class="btn btn-primary">New standing</a>
        </div>

        <form method="get" class="row g-2 align-items-end mb-4">
            <div class="col-auto">
                <label for="filter-competition" class="form-label">Competition</label>
                <select id="filter-competition" name="competition" class="form-select form-select-sm"
                        onchange="this.form.submit()">
                    <option value="">All competitions</option>
                    {% for competition in competitions %}
                        <option value="{{ competition.id }}"
                                {% if selectedCompetition == competition.id %}selected{% endif %}>
                            {{ competition.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                {% if selectedCompetition %}
                    <a href="{{ path('standing_index') }}" class="btn btn-sm btn-outline-secondary">Clear</a>
                {% endif %}
            </div>
        </form>

        {% if selectedCompetition %}
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Team</th>
                        <th class="text-center">Pld</th>
                        <th class="text-center">W</th>
                        <th class="text-center">D</th>
                        <th class="text-center">L</th>
                        <th class="text-center">GF</th>
                        <th class="text-center">GA</th>
                        <th class="text-center">GD</th>
                        <th class="text-center">Pts</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for standing in standings %}
                        <tr>
                            <td>{{ standing.position }}</td>
                            <td>{{ standing.team.name }}</td>
                            <td class="text-center">{{ standing.played }}</td>
                            <td class="text-center">{{ standing.won }}</td>
                            <td class="text-center">{{ standing.drawn }}</td>
                            <td class="text-center">{{ standing.lost }}</td>
                            <td class="text-center">{{ standing.goals }}</td>
                            <td class="text-center">{{ standing.goalsAgainst }}</td>
                            <td class="text-center">{{ standing.goals - standing.goalsAgainst }}</td>
                            <td class="text-center fw-bold">{{ standing.points }}</td>
                            <td class="text-end">
                                <a href="{{ path('standing_edit', {id: standing.id}) }}"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <form method="post" action="{{ path('standing_delete', {id: standing.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this standing?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete_standing_' ~ standing.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">No standings found.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% for phase in phases %}
                <h5 class="mt-4 mb-2">{{ phase.name }}</h5>
                <div class="table-responsive mb-2">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Home</th>
                            <th>Score</th>
                            <th>Away</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for game in groupedGames[phase.id] ?? [] %}
                            <tr>
                                <td>{{ game.datetime ? game.datetime|date('d M Y H:i') : '—' }}</td>
                                <td>{{ game.homeTeam ? game.homeTeam.shortName : '—' }}</td>
                                <td class="text-center fw-bold">
                                    {% if game.homeScore is not null %}
                                        {{ game.homeScore }} – {{ game.awayScore }}
                                        {% if game.homePenaltyScore is not null %}
                                            <small class="text-muted">({{ game.homePenaltyScore }}–{{ game.awayPenaltyScore }} pen)</small>
                                        {% endif %}
                                    {% else %}
                                        –
                                    {% endif %}
                                </td>
                                <td>{{ game.awayTeam ? game.awayTeam.shortName : '—' }}</td>
                                <td><span class="badge text-bg-secondary">{{ game.status.value }}</span></td>
                                <td class="text-end">
                                    <a href="{{ path('game_show', {id: game.id}) }}" class="btn btn-sm btn-outline-secondary">View</a>
                                    <a href="{{ path('game_edit', {id: game.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center text-muted py-3">No games.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}
        {% else %}
            <p class="text-muted">Select a competition to view standings.</p>
        {% endif %}
    </div>
{% endblock %}
