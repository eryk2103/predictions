{% extends 'base.html.twig' %}

{% block title %}New Prediction{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="h3 mb-4">New Prediction</h1>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="row mb-3">
                    <div class="col">
                        {{ form_label(form.homeScore, 'Home score', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.homeScore, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.homeScore) }}
                    </div>
                    <div class="col">
                        {{ form_label(form.awayScore, 'Away score', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.awayScore, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.awayScore) }}
                    </div>
                </div>
                <div class="row mb-4" id="penalty-fields">
                    <div class="col">
                        {{ form_label(form.homePenalty, 'Home penalties', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.homePenalty, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.homePenalty) }}
                    </div>
                    <div class="col">
                        {{ form_label(form.awayPenalty, 'Away penalties', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.awayPenalty, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.awayPenalty) }}
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="{{ path('prediction_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const homeScore = document.getElementById('{{ form.homeScore.vars.id }}');
    const awayScore = document.getElementById('{{ form.awayScore.vars.id }}');
    const penaltyFields = document.getElementById('penalty-fields');

    const isKnockout = {{ isKnockout ? 'true' : 'false' }};

    function togglePenalties() {
        const equal = homeScore.value !== '' && awayScore.value !== '' && homeScore.value === awayScore.value;
        const show = isKnockout && equal;
        penaltyFields.style.display = show ? '' : 'none';
        penaltyFields.querySelectorAll('input').forEach(i => i.required = show);
    }

    homeScore.addEventListener('input', togglePenalties);
    awayScore.addEventListener('input', togglePenalties);
    togglePenalties();
</script>
{% endblock %}
