{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as macros %}

{% block title %}My Predictions{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">My Predictions</h1>
        <span class="fs-5">Total points: <strong>{{ totalPoints }}</strong></span>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label for="filter-competition" class="form-label">Competition</label>
            <select id="filter-competition" name="competition" class="form-select form-select-sm"
                    onchange="this.form.submit()">
                <option value="">All competitions</option>
                {% for competition in competitions %}
                    <option value="{{ competition.id }}"
                            {% if selectedCompetition == competition.id %}selected{% endif %}>
                        {{ competition.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-phase" class="form-label">Phase</label>
            <select id="filter-phase" name="phase" class="form-select form-select-sm"
                    {% if selectedCompetition == null %}disabled{% endif %} onchange="this.form.submit()">
                <option value="">All phases</option>
                {% for phase in phases %}
                    <option value="{{ phase.id }}"
                            {% if selectedPhase == phase.id %}selected{% endif %}>
                        {{ phase.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% if selectedCompetition or selectedPhase %}
        <div class="col-auto">
            <a href="{{ path('prediction_index') }}" class="btn btn-sm btn-outline-secondary">Clear</a>
        </div>
        {% endif %}
    </form>

    {% if predictions is empty %}
        <p class="text-muted">You have no predictions yet.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Game</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-center">Prediction</th>
                        <th class="text-center">Points</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for prediction in predictions %}
                    <tr>
                        <td>
                            <span class="d-inline-flex align-items-center gap-1">
                                {{ macros.team_logo(prediction.game.homeTeam, 20) }}
                                {{ prediction.game.homeTeam ? prediction.game.homeTeam.shortName : '—' }}
                                vs
                                {{ prediction.game.awayTeam ? prediction.game.awayTeam.shortName : '—' }}
                                {{ macros.team_logo(prediction.game.awayTeam, 20) }}
                            </span>
                        </td>
                        <td>{{ macros.local_time(prediction.game.datetime) }}</td>
                        <td><span class="badge text-bg-secondary">{{ prediction.game.status.value|replace({'_': ' '})|title }}</span></td>
                        <td class="text-center fw-bold">
                            {{ prediction.homeScore }} – {{ prediction.awayScore }}
                            {% if prediction.homePenalty is not null %}
                                <small class="text-muted">({{ prediction.homePenalty }} – {{ prediction.awayPenalty }} pens)</small>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% if prediction.points is not null %}
                                <span class="fw-bold">{{ prediction.points }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {% if not (prediction.game.datetime and date() >= prediction.game.datetime) %}
                                <a href="{{ path('prediction_edit', {id: prediction.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form method="post" action="{{ path('prediction_delete', {id: prediction.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete this prediction?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_prediction_' ~ prediction.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {{ include('_pagination.twig', {label: 'predictions'}) }}
    {% endif %}
</div>
{% endblock %}
