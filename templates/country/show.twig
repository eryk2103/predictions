{% extends 'base.html.twig' %}

{% block title %}{{ country.name }}{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">{{ country.name }}</h1>
        <div>
            <a href="{{ path('admin_country_edit', {id: country.id}) }}" class="btn btn-primary">Edit</a>
            <form method="post" action="{{ path('admin_country_delete', {id: country.id}) }}" class="d-inline"
                  onsubmit="return confirm('Delete {{ country.name }}?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_country_' ~ country.id) }}">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Flag</dt>
                <dd class="col-sm-9">{{ country.flag ?: '—' }}</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">{{ country.createdAt|date('Y-m-d H:i') }}</dd>

                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">{{ country.updatedAt|date('Y-m-d H:i') }}</dd>
            </dl>
        </div>
    </div>

    <a href="{{ path('admin_country_index') }}" class="btn btn-link px-0 mt-3">← Back to list</a>
</div>
{% endblock %}
