{% extends 'base.html.twig' %}

{% block title %}Edit phase — {{ competition.name }}{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="h3 mb-1">Edit phase</h1>
            <p class="text-muted mb-4">{{ competition.name }}</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.type, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.type, {attr: {class: 'form-select'}}) }}
                    {{ form_errors(form.type) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.sequence, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.sequence, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.sequence) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="{{ path('competition_show', {id: competition.id}) }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
