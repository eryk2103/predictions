{% extends 'base.html.twig' %}

{% block title %}Rankings{% endblock %}

{% block content %}
<div class="container py-4">
    <h1 class="h3 mb-4">Rankings</h1>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label for="filter-competition" class="form-label">Competition</label>
            <select id="filter-competition" name="competition" class="form-select form-select-sm"
                    onchange="this.form.submit()">
                <option value="">All competitions</option>
                {% for competition in competitions %}
                    <option value="{{ competition.id }}"
                            {% if selectedCompetition == competition.id %}selected{% endif %}>
                        {{ competition.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <label for="filter-phase" class="form-label">Phase</label>
            <select id="filter-phase" name="phase" class="form-select form-select-sm"
                    {% if selectedCompetition == null %}disabled{% endif %} onchange="this.form.submit()">
                <option value="">All phases</option>
                {% for phase in phases %}
                    <option value="{{ phase.id }}"
                            {% if selectedPhase == phase.id %}selected{% endif %}>
                        {{ phase.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% if selectedCompetition or selectedPhase %}
        <div class="col-auto">
            <a href="{{ path('ranking_index') }}" class="btn btn-sm btn-outline-secondary">Clear</a>
        </div>
        {% endif %}
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th class="text-center">Points</th>
                </tr>
            </thead>
            <tbody>
            {% for row in rankings %}
                <tr{% if app.user and app.user.id == row.id %} class="table-primary"{% endif %}>
                    <td>{{ loop.index }}</td>
                    <td>{{ row.username }}</td>
                    <td class="text-center fw-bold">{{ row.points }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">No rankings yet.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
